{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "PrintBroker": {
    "BaseDataDirectory": "",
    "DatabaseFileName": "printbroker.db",
    "MaxRetries": 3,
    "WorkerPollSeconds": 1,
    "PrintTimeoutSeconds": 45,
    "RetryBackoffSeconds": 5,
    "ListenUrl": "http://127.0.0.1:5177"
  },
  "LocalApiSecurity": {
    "Token": "",
    "TokenFileName": "broker.token",
    "HeaderName": "X-Local-Token"
  }
}
