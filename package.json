{
  "name": "mirror_sballando",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "electron-builder --win"
  },
  "author": "Valerio Poetico",
  "license": "ISC",
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "ssh2-sftp-client": "^12.0.1"
  },
  "build": {
  "appId": "it.valpoe.mirrorsballando",
  "productName": "Mirror Sballando",
  "win": {
    "icon": "favicon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64", "ia32"]
      }
    ]
  },
  "files": [
    "main.js",
    "preload.js",
    "favicon.ico",
    "print.txt"
  ],
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "shortcutName": "Mirror Sballando",
    "installerIcon": "favicon.ico",
    "uninstallerIcon": "favicon.ico",
    "deleteAppDataOnUninstall": true
  }
}
}
