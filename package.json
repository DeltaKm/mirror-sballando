{
  "name": "mirror_sballando",
  "version": "1.0.0",
  "description": "Mirror Sballando - Professional offline-first photobooth desktop app",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electronmon .",
    "start": "electron .",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": "Valerio Poetico",
  "license": "ISC",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12",
    "electronmon": "^2.0.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^7.1.2",
    "wait-on": "^8.0.3"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "framer-motion": "^12.23.12",
    "konva": "^9.3.22",
    "pdf-to-printer": "^5.6.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "sharp": "^0.34.3",
    "ssh2-sftp-client": "^12.0.1",
    "uuid": "^11.1.0"
  },
  "build": {
    "appId": "it.valpoe.mirrorsballando",
    "productName": "Mirror Sballando",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "win": {
      "icon": "favicon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "files": [
      "src/main/**/*",
      "dist/renderer/**/*",
      "package.json",
      "favicon.ico",
      "PRINT_BROKER_INTEGRATION.md"
    ],
    "extraResources": [
      {
        "from": "storage",
        "to": "storage",
        "filter": [
          "**/*"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Mirror Sballando",
      "installerIcon": "favicon.ico",
      "uninstallerIcon": "favicon.ico",
      "deleteAppDataOnUninstall": false
    }
  }
}
